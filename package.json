{
  "name": "air-ide-monorepo",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter desktop dev:tauri",
    "build": "pnpm --filter desktop build:tauri",
    "check": "pnpm --filter desktop check",
    "e2e:smoke": "node scripts/e2e/run-all.mjs --level smoke",
    "e2e:regression": "node scripts/e2e/run-all.mjs --level regression",
    "test:release": "node --test scripts/release/asset-names.test.mjs"
  },
  "devDependencies": {
    "@codemirror/lsp-client": "^6.3.0",
    "playwright-core": "^1.64.1"
  }
}
